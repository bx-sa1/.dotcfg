#!/usr/bin/env python3

import sys
import time

arg_rounds = 3
arg_break = 5
arg_work = 25

current_state = "work"
rounds_done = 0
elapsed = 0
last_time = time.monotonic_ns()

def tick_time():
    global elapsed
    global last_time

    now_time = time.monotonic_ns()
    delta = now_time - last_time
    elapsed += delta
    last_time = now_time
    time.sleep(abs(1.0 - (delta/1000000)))

def next_state():
    global current_state
    global elapsed
    global rounds_done

    match current_state:
        case "work":
            if elapsed >= arg_work:
                if rounds_done >= arg_rounds:
                    current_state = "done"
                    print("Done")
                else:
                    current_state = "break"
                    print("Break Time!")
        case "break":
            if elapsed >= arg_break:
                rounds_done = rounds_done + 1
                if rounds_done >= arg_rounds:
                    current_state = "done"
                    print("Done")
                else:
                    current_state = "work"
                    print("Work Time!")

args = iter(sys.argv)
arg = next(args, None)
while arg is not None:
    if arg == "-r" or arg == "--rounds":
        arg = next(args, None)
        arg_rounds = int(arg)
    elif arg == "-b" or arg == "--break":
        arg = next(args, None)
        arg_break = int(arg)
    elif args == "-w" or arg == "--work":
        arg = next(args, None)
        arg_work = int(arg)
    arg = next(args, None)

print("Work time: ", arg_work)
print("Break time: ", arg_break)
print("Rounds: ", arg_rounds)

while current_state != "done":
    tick_time()
    next_state(current_state, rounds_done, elapsed)
